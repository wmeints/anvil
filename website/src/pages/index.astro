---
import "../styles/global.css";

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}/${path}`.replace(/\/+/g, "/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Firebrick</title>
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
  </head>
  <body class="flex min-h-screen items-center justify-center p-4">
    <main class="max-w-xl text-center">
      <h1 class="text-4xl font-bold">Firebrick</h1>
      <p class="mt-4">A microVM sandbox for coding agents.</p>
      <a class="mt-6 inline-block underline" href={withBase("docs/")}>
        Read the docs
      </a>
    </main>
  </body>
</html>
